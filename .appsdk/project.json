{
  "access": {
    "protected_paths": [
      ".appsdk/**",
      "generated/**",
      "protected/source/**"
    ]
  },
  "development_scenarios": {
    "enabled": [],
    "manifest": ".appsdk/contracts/development-scenarios.manifest.json"
  },
  "governance": {
    "active_kind": "immutable_consumable_library",
    "active_root": "active/lib/**",
    "debug_merge_comment_required": true,
    "freeze_requirements": [
      "git_clean",
      "source_commit_or_tag",
      "library_hash",
      "public_api_hash",
      "review_pass",
      "previous_active_immutable"
    ],
    "generated_kinds": [
      "compiler_output",
      "indexes"
    ],
    "generated_root": "generated/**",
    "playground_retention": "archive_then_remove",
    "playground_root": "playground/experiments/**",
    "promotion_requires": [
      "experiment_evidence",
      "architecture_review_pass",
      "unique_owner",
      "required_gates"
    ],
    "protected_kinds": [
      "source",
      "contracts",
      "history"
    ],
    "protected_root": "protected/**",
    "record_contracts": [
      "contracts/records/worktree-record.schema.json",
      "contracts/records/reproduction-record.schema.json",
      "contracts/records/evidence-record.schema.json",
      "contracts/records/fix-candidate-record.schema.json",
      "contracts/records/goal-clarification-record.schema.json",
      "contracts/records/review-record.schema.json",
      "contracts/records/effectiveness-record.schema.json",
      "contracts/records/pre-review-validation-record.schema.json",
      "contracts/records/collaboration-record.schema.json",
      "contracts/records/collaboration-index.schema.json",
      "contracts/records/merge-queue-record.schema.json",
      "contracts/records/merge-queue-state.schema.json",
      "contracts/records/integration-record.schema.json",
      "contracts/records/mainline-receipt-record.schema.json",
      "contracts/records/merge-record.schema.json",
      "contracts/records/promotion-record.schema.json",
      "contracts/records/regression-report.schema.json",
      "contracts/records/freeze-record.schema.json",
      "contracts/records/record-graph.contract.json"
    ],
    "runtime_forbidden_roots": [
      "playground/**",
      "generated/**"
    ],
    "zone_transition_contract": "contracts/transitions/zone-transition-manifest.json"
  },
  "guidance": {
    "compiled_manifest": ".appsdk/guidance/compiled.json",
    "enforcement": "advisory",
    "rule_sources": [
      {
        "kind": "agents",
        "path": "AGENTS.md",
        "precedence": 100,
        "required": true,
        "source_id": "project-agents"
      },
      {
        "kind": "skill",
        "path": "skills/agent-memory-development/SKILL.md",
        "precedence": 150,
        "required": true,
        "source_id": "agent-memory-development"
      },
      {
        "contract_path": ".appsdk/skills/appsdk-project-governance/appsdk-guidance.json",
        "kind": "skill",
        "path": ".appsdk/skills/appsdk-project-governance/SKILL.md",
        "precedence": 200,
        "required": true,
        "source_id": "appsdk-governance-skill"
      }
    ]
  },
  "lifecycle": {
    "stage": "contract_bound"
  },
  "lifecycles": {
    "artifact": "generated",
    "issue": "open",
    "library": "draft",
    "source_snapshot": "mutable"
  },
  "modules": [
    {
      "active_artifact": "active/lib/agent-memory/**",
      "artifact_paths": [
        "agent-memory-bridge"
      ],
      "build": {
        "args": [
          "-c",
          "./scripts/setup/verify-local.sh && mkdir -p generated/modules/agent-memory/lib && cp target/release/agent-memory-bridge generated/modules/agent-memory/lib/agent-memory-bridge"
        ],
        "program": "sh",
        "working_directory": "."
      },
      "contract_paths": [
        "contracts/**",
        "plugin/manifest.json",
        ".appsdk/maps/**"
      ],
      "dependency_modules": [],
      "deployment_operations": [],
      "generated_outputs": [
        "generated/modules/agent-memory/**"
      ],
      "module_id": "agent-memory",
      "owned_paths": [
        "src/**",
        "plugin/**",
        "compaction/**",
        "tests/**",
        "scripts/**",
        "docs/**",
        "Cargo.toml",
        "Cargo.lock",
        "README.md",
        "MAIN.md",
        "MEMORY.md",
        "AGENTS.md",
        "skills/**"
      ],
      "regression": {
        "allow_skipped": false,
        "command": {
          "args": [
            "scripts/setup/verify-ci.sh"
          ],
          "program": "sh",
          "working_directory": "."
        },
        "input_paths": [
          "src/**",
          "plugin/**",
          "compaction/**",
          "tests/**",
          "contracts/**"
        ],
        "minimum_test_count": 1,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": [
          "source_change",
          "contract_change",
          "public_api_change",
          "artifact_change",
          "dependency_change"
        ],
        "required_before_freeze": true,
        "suite_id": "agent-memory-regression"
      },
      "source_owner": "agent-memory",
      "stage": "source_implemented"
    }
  ],
  "project_id": "agent-memory",
  "schema_version": 1,
  "sdk": {
    "bundle_manifest": ".appsdk/contracts/sdk-bundle.manifest.json",
    "name": "appsdk",
    "resource_record": ".appsdk/sdk-resources.json",
    "version": "0.1.6"
  }
}
